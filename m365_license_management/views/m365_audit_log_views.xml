<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_m365_audit_log_list" model="ir.ui.view">
        <field name="name">m365.audit.log.list</field>
        <field name="model">m365.audit.log</field>
        <field name="arch" type="xml">
            <list string="Audit Logs" create="0" edit="0" delete="0"
                  decoration-danger="status == 'failed'">
                <field name="date"/>
                <field name="tenant_id"/>
                <field name="action"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'success'"
                       decoration-danger="status == 'failed'"
                       decoration-info="status == 'info'"/>
                <field name="message"/>
                <field name="request_id" optional="show"/>
                <field name="user_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_m365_audit_log_form" model="ir.ui.view">
        <field name="name">m365.audit.log.form</field>
        <field name="model">m365.audit.log</field>
        <field name="arch" type="xml">
            <form string="Audit Log" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="tenant_id"/>
                            <field name="action"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="request_id"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <field name="message"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_m365_audit_log_search" model="ir.ui.view">
        <field name="name">m365.audit.log.search</field>
        <field name="model">m365.audit.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="message"/>
                <field name="tenant_id"/>
                <field name="user_id"/>
                <filter name="failed" string="Failures" domain="[('status', '=', 'failed')]"/>
                <filter name="success" string="Success" domain="[('status', '=', 'success')]"/>
                <group>
                    <filter name="group_tenant" string="Tenant" context="{'group_by': 'tenant_id'}"/>
                    <filter name="group_action" string="Operation" context="{'group_by': 'action'}"/>
                    <filter name="group_status" string="Result" context="{'group_by': 'status'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_m365_audit_log" model="ir.actions.act_window">
        <field name="name">Audit Logs</field>
        <field name="res_model">m365.audit.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
