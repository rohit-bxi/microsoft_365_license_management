<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_m365_user_tenant_mapping_list" model="ir.ui.view">
        <field name="name">m365.user.tenant.mapping.list</field>
        <field name="model">m365.user.tenant.mapping</field>
        <field name="arch" type="xml">
            <list string="User Tenant Mapping">
                <field name="user_id"/>
                <field name="tenant_ids" widget="many2many_tags"/>
                <field name="tenant_count"/>
            </list>
        </field>
    </record>

    <record id="view_m365_user_tenant_mapping_form" model="ir.ui.view">
        <field name="name">m365.user.tenant.mapping.form</field>
        <field name="model">m365.user.tenant.mapping</field>
        <field name="arch" type="xml">
            <form string="User Tenant Mapping">
                <sheet>
                    <group>
                        <field name="user_id" options="{'no_create': True}"/>
                    </group>
                    <separator string="Tenants"/>
                    <field name="tenant_ids" nolabel="1" options="{'no_create': True}">
                        <list>
                            <field name="name"/>
                            <field name="domain"/>
                            <field name="tenant_type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'connected'"
                                   decoration-danger="state == 'error'"/>
                        </list>
                    </field>
                    <div class="alert alert-info mt-3" role="alert">
                        The user sees the subscriptions, users, license requests and audit
                        logs of these tenants only. A user without mapping sees no tenant.
                        Microsoft 365 administrators see every tenant.
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_m365_user_tenant_mapping_search" model="ir.ui.view">
        <field name="name">m365.user.tenant.mapping.search</field>
        <field name="model">m365.user.tenant.mapping</field>
        <field name="arch" type="xml">
            <search string="User Tenant Mapping">
                <field name="user_id"/>
                <field name="tenant_ids"/>
                <filter name="filter_no_tenant" string="Without Tenant"
                        domain="[('tenant_ids', '=', False)]"/>
                <group>
                    <filter name="group_tenant" string="Tenant" context="{'group_by': 'tenant_ids'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_m365_user_tenant_mapping" model="ir.actions.act_window">
        <field name="name">User Tenant Mapping</field>
        <field name="res_model">m365.user.tenant.mapping</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Map a user to the tenants they can see</p>
            <p>Microsoft 365 users only see the records of the tenants mapped to them.
               Administrators see every tenant.</p>
        </field>
    </record>
</odoo>
