<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Partner Center offers -->
    <record id="view_m365_pc_offer_list" model="ir.ui.view">
        <field name="name">m365.pc.offer.list</field>
        <field name="model">m365.pc.offer</field>
        <field name="arch" type="xml">
            <list string="Partner Center Offers" create="0">
                <field name="name"/>
                <field name="sku_title"/>
                <field name="term_duration"/>
                <field name="billing_cycle"/>
                <field name="catalog_item_id" optional="show"/>
                <field name="provisioning_id" optional="hide"/>
                <field name="min_quantity" optional="hide"/>
                <field name="max_quantity" optional="hide"/>
                <field name="account_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_m365_pc_offer_search" model="ir.ui.view">
        <field name="name">m365.pc.offer.search</field>
        <field name="model">m365.pc.offer</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="sku_title"/>
                <field name="catalog_item_id"/>
                <filter name="monthly" string="Monthly Term" domain="[('term_duration', '=', 'P1M')]"/>
                <filter name="annual" string="Annual Term" domain="[('term_duration', '=', 'P1Y')]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_product" string="Product" context="{'group_by': 'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_m365_pc_offer" model="ir.actions.act_window">
        <field name="name">Partner Center Offers</field>
        <field name="res_model">m365.pc.offer</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No offer yet</p>
            <p>Synchronise the catalog from the Partner Center account.</p>
        </field>
    </record>

    <!-- Subscription orders -->
    <record id="view_m365_pc_order_list" model="ir.ui.view">
        <field name="name">m365.pc.order.list</field>
        <field name="model">m365.pc.order</field>
        <field name="arch" type="xml">
            <list string="Subscription Orders" decoration-danger="state == 'failed'"
                  decoration-muted="state in ('rejected', 'cancelled')"
                  decoration-success="state == 'done'">
                <field name="name"/>
                <field name="tenant_id"/>
                <field name="customer_id" optional="show"/>
                <field name="pc_order_ids" optional="show"/>
                <field name="amount_total" optional="show"/>
                <field name="currency" optional="hide"/>
                <field name="requested_by" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('submitted', 'ordered')"
                       decoration-success="state == 'done'"
                       decoration-danger="state in ('failed', 'rejected')"/>
            </list>
        </field>
    </record>

    <record id="view_m365_pc_order_form" model="ir.ui.view">
        <field name="name">m365.pc.order.form</field>
        <field name="model">m365.pc.order</field>
        <field name="arch" type="xml">
            <form string="Subscription Order">
                <header>
                    <field name="is_admin" invisible="1"/>
                    <button name="action_submit" type="object" string="Submit for Approval"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve and Order"
                            class="btn-primary" invisible="state != 'submitted' or not is_admin"
                            confirm="Order these subscriptions in Partner Center? They are billed to your partner account."/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'submitted' or not is_admin"/>
                    <button name="action_retry" type="object" string="Retry" class="btn-primary"
                            invisible="state != 'failed' or not is_admin"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'submitted', 'failed')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state not in ('rejected', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,ordered,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <div class="alert alert-danger" role="alert" invisible="not error_message">
                        <field name="error_message" nolabel="1" class="d-inline"/>
                    </div>
                    <div class="alert alert-info" role="alert" invisible="state != 'ordered'">
                        Ordered in Partner Center. The order is done when Partner Center has
                        provisioned the subscriptions and the licenses appear in the tenant
                        (checked every 15 minutes).
                    </div>
                    <group>
                        <group>
                            <field name="tenant_id" options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="customer_id"/>
                            <field name="account_id" options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="attestation_accepted" readonly="state != 'draft'"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="requested_by"/>
                            <field name="approver_id"/>
                            <field name="cart_id" invisible="not cart_id"/>
                            <field name="pc_order_ids" invisible="not pc_order_ids"/>
                            <field name="sent_date" invisible="not sent_date"/>
                            <field name="done_date" invisible="not done_date"/>
                            <field name="amount_total" invisible="not sent_date"/>
                            <field name="currency" invisible="not currency"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="account_id" column_invisible="1"/>
                            <field name="offer_id" options="{'no_create': True}"/>
                            <field name="quantity"/>
                            <field name="subscription_id" optional="show"/>
                            <field name="pc_status" optional="show"/>
                            <field name="baseline_units" optional="hide"/>
                            <field name="delivered" optional="hide"/>
                        </list>
                    </field>
                    <group>
                        <field name="reason" readonly="state != 'draft'"/>
                        <field name="reject_reason" invisible="state not in ('submitted', 'rejected')"
                               readonly="state != 'submitted'"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_m365_pc_order_search" model="ir.ui.view">
        <field name="name">m365.pc.order.search</field>
        <field name="model">m365.pc.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="tenant_id"/>
                <field name="customer_id"/>
                <field name="pc_order_ids"/>
                <filter name="pending" string="Waiting Approval" domain="[('state', '=', 'submitted')]"/>
                <filter name="ordered" string="Ordered" domain="[('state', '=', 'ordered')]"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_tenant" string="Tenant" context="{'group_by': 'tenant_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_m365_pc_order" model="ir.actions.act_window">
        <field name="name">Subscription Orders</field>
        <field name="res_model">m365.pc.order</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Buy Microsoft 365 subscriptions</p>
            <p>Use Buy Licenses on a tenant, or Next Step of the provisioning.</p>
        </field>
    </record>

    <!-- Provisioning: the tenants with the status of each step -->
    <record id="view_m365_tenant_provisioning_list" model="ir.ui.view">
        <field name="name">m365.tenant.provisioning.list</field>
        <field name="model">m365.tenant</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Provisioning" create="0">
                <header>
                    <button name="action_provisioning_next" type="object" string="Next Step"
                            class="btn-primary"
                            groups="m365_license_management.group_m365_admin"/>
                    <button name="action_provisioning_report" type="object" string="Report"/>
                </header>
                <field name="tenant_customer_id"/>
                <field name="name"/>
                <field name="domain" optional="hide"/>
                <field name="prov_state" widget="badge" decoration-success="prov_state == 'done'"
                       decoration-danger="prov_state == 'failed'"
                       decoration-info="prov_state == 'progress'"/>
                <field name="prov_tenant" widget="badge" decoration-success="prov_tenant == 'done'"
                       decoration-danger="prov_tenant == 'failed'"
                       decoration-warning="prov_tenant in ('pending', 'action')"/>
                <field name="prov_connection" widget="badge"
                       decoration-success="prov_connection == 'done'"
                       decoration-danger="prov_connection == 'failed'"
                       decoration-warning="prov_connection in ('pending', 'action')"/>
                <!-- PARTNER CENTER (disabled): GDAP -->
                <field name="prov_gdap" widget="badge" column_invisible="1"
                       decoration-success="prov_gdap == 'done'"
                       decoration-danger="prov_gdap == 'failed'"
                       decoration-warning="prov_gdap in ('pending', 'action')"/>
                <field name="prov_subscriptions" widget="badge"
                       decoration-success="prov_subscriptions == 'done'"
                       decoration-danger="prov_subscriptions == 'failed'"
                       decoration-warning="prov_subscriptions in ('pending', 'action')"/>
                <field name="prov_users" widget="badge" decoration-success="prov_users == 'done'"
                       decoration-warning="prov_users in ('pending', 'action')"/>
                <field name="prov_licenses" widget="badge"
                       decoration-success="prov_licenses == 'done'"
                       decoration-danger="prov_licenses == 'failed'"
                       decoration-warning="prov_licenses in ('pending', 'action')"/>
                <field name="prov_verification" widget="badge"
                       decoration-success="prov_verification == 'done'"
                       decoration-danger="prov_verification == 'failed'"
                       decoration-warning="prov_verification in ('pending', 'action')"/>
                <field name="prov_summary"/>
            </list>
        </field>
    </record>

    <record id="action_m365_provisioning" model="ir.actions.act_window">
        <field name="name">Provisioning</field>
        <field name="res_model">m365.tenant</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_m365_tenant_provisioning_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_m365_tenant_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No tenant yet</p>
            <p>Bulk Import Tenant (type New) uploads the customers; Next Step then runs the
               provisioning of each one: tenant, connection, subscriptions, users, licenses
               and verification.</p>
        </field>
    </record>

    <!-- PARTNER CENTER (disabled): purchase, catalog, GDAP of the Partner Center account
    <! - Partner Center account: purchase, catalog, GDAP - >
    <record id="view_m365_partner_account_form_provisioning" model="ir.ui.view">
        <field name="name">m365.partner.account.form.provisioning</field>
        <field name="model">m365.partner.account</field>
        <field name="inherit_id" ref="view_m365_partner_account_form"/>
        <field name="arch" type="xml">
            <! - PARTNER CENTER (disabled): catalog of Partner Center
            <xpath expr="//header/button[@name='action_test_connection']" position="after">
                <button name="action_sync_offers" type="object" string="Synchronise Catalog"
                        invisible="state != 'connected' or purchase_channel != 'partner_center'"/>
            </xpath>
            - >
            <! - PARTNER CENTER (disabled): offers of Partner Center
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_offers" type="object" class="oe_stat_button"
                        icon="fa-list" invisible="purchase_channel != 'partner_center'">
                    <field name="offer_count" widget="statinfo" string="Offers"/>
                </button>
            </xpath>
            - >
            <! - PARTNER CENTER (disabled): purchase through Partner Center, GDAP
            <xpath expr="//notebook" position="before">
                <group>
                    <group string="Purchase">
                        <field name="purchase_channel" widget="radio"/>
                        <field name="catalog_country" invisible="purchase_channel != 'partner_center'"/>
                        <field name="catalog_filter" invisible="purchase_channel != 'partner_center'"/>
                        <field name="require_mca_pc" invisible="purchase_channel != 'partner_center'"/>
                        <field name="last_offer_sync" invisible="purchase_channel != 'partner_center'"/>
                    </group>
                    <group string="GDAP (Shared App in the Partner Tenant)">
                        <field name="gdap_role_ids"/>
                        <field name="gdap_duration_days"/>
                        <field name="gdap_auto_extend"/>
                    </group>
                </group>
            </xpath>
            - >
        </field>
    </record>
    -->

    <!-- Tenant: GDAP, provisioning, subscription orders -->
    <record id="view_m365_tenant_form_provisioning" model="ir.ui.view">
        <field name="name">m365.tenant.form.provisioning</field>
        <field name="model">m365.tenant</field>
        <field name="inherit_id" ref="view_m365_tenant_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_test_connection']" position="before">
                <button name="action_provisioning_next" type="object" string="Next Step"
                        invisible="prov_state == 'done'"
                        groups="m365_license_management.group_m365_admin"/>
            </xpath>
            <!-- PARTNER CENTER (disabled): subscription orders of Partner Center
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_pc_orders" type="object" class="oe_stat_button"
                        icon="fa-shopping-basket" invisible="not pc_order_count"
                        groups="m365_license_management.group_m365_admin">
                    <field name="pc_order_count" widget="statinfo" string="Subscription Orders"/>
                </button>
            </xpath>
            -->
            <xpath expr="//page[@name='purchasing']" position="before">
                <page string="Provisioning" name="provisioning">
                    <group>
                        <group string="Steps">
                            <field name="prov_state" widget="badge"
                                   decoration-success="prov_state == 'done'"
                                   decoration-danger="prov_state == 'failed'"
                                   decoration-info="prov_state == 'progress'"/>
                            <field name="prov_tenant"/>
                            <field name="prov_connection"/>
                            <field name="prov_gdap" invisible="1"/>
                            <field name="prov_subscriptions"/>
                            <field name="prov_users"/>
                            <field name="prov_licenses"/>
                            <field name="prov_verification"/>
                            <field name="prov_summary"/>
                        </group>
                        <!-- PARTNER CENTER (disabled): GDAP needs a partner tenant; hidden,
                             anchor of other views -->
                        <group string="GDAP" groups="m365_license_management.group_m365_admin"
                               invisible="1">
                            <field name="gdap_status"/>
                            <field name="gdap_name" invisible="not gdap_name"/>
                            <field name="gdap_end_date" invisible="not gdap_end_date"/>
                            <field name="gdap_role_count" invisible="not gdap_role_count"/>
                            <field name="gdap_approval_url" widget="CopyClipboardChar"
                                   invisible="not gdap_approval_url"/>
                            <field name="gdap_checked" invisible="not gdap_checked"/>
                            <field name="gdap_error" invisible="not gdap_error"/>
                            <div colspan="2">
                                <button name="action_refresh_gdap" type="object"
                                        string="Refresh GDAP" class="btn-secondary me-2"
                                        invisible="not tenant_id"/>
                                <button name="action_request_gdap" type="object"
                                        string="Request GDAP" class="btn-secondary"
                                        invisible="not tenant_id or gdap_status in ('active', 'expiring', 'activating', 'approvalPending')"/>
                            </div>
                        </group>
                    </group>
                    <group string="Subscriptions to Buy">
                        <field name="requested_subscriptions" nolabel="1" colspan="2"
                               placeholder="Microsoft 365 Business Basic = 10"/>
                    </group>
                    <div class="mt-2">
                        <button name="action_provisioning_report" type="object"
                                string="Provisioning Report" class="btn-link"/>
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_m365_tenant_provisioning_next" model="ir.actions.server">
        <field name="name">Next Provisioning Step</field>
        <field name="model_id" ref="model_m365_tenant"/>
        <field name="binding_model_id" ref="model_m365_tenant"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('m365_license_management.group_m365_admin'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_provisioning_next()</field>
    </record>

    <!-- License requests: verification -->
    <record id="view_m365_license_request_form_verification" model="ir.ui.view">
        <field name="name">m365.license.request.form.verification</field>
        <field name="model">m365.license.request</field>
        <field name="inherit_id" ref="view_m365_license_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_reset_draft']" position="after">
                <button name="action_verify" type="object" string="Verify"
                        invisible="state != 'done' or is_mfa or not is_admin"/>
            </xpath>
            <xpath expr="//field[@name='executed_date']" position="after">
                <field name="verification_state" widget="badge"
                       decoration-success="verification_state == 'verified'"
                       decoration-danger="verification_state in ('mismatch', 'error')"
                       decoration-info="verification_state == 'pending'"
                       invisible="not verification_state"/>
                <field name="verification_date" invisible="not verification_date"/>
            </xpath>
            <xpath expr="//field[@name='error_message']" position="after">
                <field name="verification_message" invisible="not verification_message"/>
            </xpath>
        </field>
    </record>

    <record id="view_m365_license_request_list_verification" model="ir.ui.view">
        <field name="name">m365.license.request.list.verification</field>
        <field name="model">m365.license.request</field>
        <field name="inherit_id" ref="view_m365_license_request_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="verification_state" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
