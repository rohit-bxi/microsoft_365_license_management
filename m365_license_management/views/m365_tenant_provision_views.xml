<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Partner Center account -->
    <record id="view_m365_partner_account_list" model="ir.ui.view">
        <field name="name">m365.partner.account.list</field>
        <field name="model">m365.partner.account</field>
        <field name="arch" type="xml">
            <list string="Partner Center Accounts" decoration-danger="state == 'error'">
                <field name="name"/>
                <field name="partner_name"/>
                <field name="partner_tenant_id" optional="hide"/>
                <field name="provision_count" string="Tenants"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'connected'"
                       decoration-danger="state == 'error'"
                       decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_m365_partner_account_form" model="ir.ui.view">
        <field name="name">m365.partner.account.form</field>
        <field name="model">m365.partner.account</field>
        <field name="arch" type="xml">
            <form string="Partner Center Account">
                <header>
                    <button name="action_test_connection" type="object" string="Test Connection"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,connected"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_provisions" type="object" class="oe_stat_button"
                                icon="fa-building">
                            <field name="provision_count" widget="statinfo" string="Tenants"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. BXI Technologies CSP"/></h1>
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="state != 'error'">
                        <strong>Last error:</strong>
                        <field name="last_error" nolabel="1" class="d-inline"/>
                    </div>
                    <group>
                        <group string="App Registration (App-only)">
                            <field name="partner_tenant_id"/>
                            <field name="client_id"/>
                            <field name="client_secret" password="True"/>
                            <field name="partner_name" invisible="not partner_name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="New Customers">
                            <field name="default_culture"/>
                            <field name="default_language"/>
                            <field name="enable_gdap"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Endpoints" name="endpoints">
                            <group>
                                <field name="authority_url"/>
                                <field name="api_url"/>
                                <field name="api_scope"/>
                            </group>
                        </page>
                        <page string="Setup Guide" name="guide">
                            <div class="o_m365_guide">
                                <h4>1. Requirements</h4>
                                <p>A Microsoft <b>Cloud Solution Provider (CSP)</b> partner account
                                   (direct bill partner or indirect provider). New tenants are
                                   created as customers of this partner.</p>
                                <h4>2. Register the application</h4>
                                <p>Partner Center &#8594; Account settings &#8594;
                                   <b>App management</b> &#8594; <i>Add new web app</i>, or register a
                                   web application in Microsoft Entra ID and add it there. Copy the
                                   <b>Account ID</b> (partner directory ID), the
                                   <b>App ID</b> and create a <b>key</b> (client secret).
                                   App-only access is enough to check domains and addresses and
                                   to create customers; it needs no user sign-in nor MFA.</p>
                                <h4>3. Test the connection</h4>
                                <p>Save and press <b>Test Connection</b>: Odoo reads your legal
                                   business profile. Then go to <i>Create Tenants in Server</i>.</p>
                                <p class="text-muted">Use an integration sandbox account first:
                                   customers created in production are real tenants and cannot
                                   be deleted from Odoo.</p>
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_m365_partner_account" model="ir.actions.act_window">
        <field name="name">Partner Center Accounts</field>
        <field name="res_model">m365.partner.account</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Connect your Partner Center account</p>
            <p>New Microsoft 365 tenants are created as customers of your Cloud Solution
               Provider (CSP) partner account.</p>
        </field>
    </record>

    <!-- Tenants to create -->
    <record id="view_m365_tenant_provision_list" model="ir.ui.view">
        <field name="name">m365.tenant.provision.list</field>
        <field name="model">m365.tenant.provision</field>
        <field name="arch" type="xml">
            <list string="Tenants to Create" decoration-danger="state == 'failed'"
                  decoration-muted="state == 'done'" decoration-info="state == 'queued'">
                <field name="name"/>
                <field name="domain"/>
                <field name="country_id" optional="show"/>
                <field name="email" optional="show"/>
                <field name="partner_account_id" optional="hide"/>
                <field name="customer_tenant_id" optional="show"/>
                <field name="customer_id" optional="hide"/>
                <field name="created_date" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('ready', 'done')"
                       decoration-info="state in ('draft', 'queued')"
                       decoration-danger="state == 'failed'"/>
                <field name="error_message" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_m365_tenant_provision_form" model="ir.ui.view">
        <field name="name">m365.tenant.provision.form</field>
        <field name="model">m365.tenant.provision</field>
        <field name="arch" type="xml">
            <form string="Tenant to Create" duplicate="0">
                <header>
                    <button name="action_check" type="object" string="Check"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_check" type="object" string="Check Again"
                            invisible="state != 'ready'"/>
                    <button name="action_create" type="object" string="Create in Microsoft 365"
                            class="btn-primary" invisible="state != 'ready'"
                            confirm="Create this tenant in Microsoft 365? A real tenant is created and it cannot be deleted from Odoo."/>
                    <button name="action_create" type="object" string="Retry"
                            class="btn-primary" invisible="state != 'failed'"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state != 'failed'"/>
                    <button name="action_register_tenant" type="object"
                            string="Manage Licenses in Odoo" class="btn-primary"
                            invisible="state != 'done' or tenant_record_id"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,ready,queued,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_register_tenant" type="object"
                                class="oe_stat_button" icon="fa-cloud"
                                invisible="not tenant_record_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Odoo Tenant</span>
                            </div>
                        </button>
                    </div>
                    <field name="tenant_record_id" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Contoso Ltd"
                                   readonly="state in ('queued', 'done')"/></h1>
                    </div>
                    <div class="alert alert-danger" role="alert"
                         invisible="not error_message or state not in ('draft', 'failed')">
                        <field name="error_message" nolabel="1" class="d-inline"/>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="state != 'failed' or not pc_request_id">
                        Partner Center gave no answer, so the tenant may have been created.
                        <b>Retry</b> sends the same request ID: Microsoft then returns the
                        tenant it created instead of creating a second one.
                    </div>
                    <div class="alert alert-info" role="alert" invisible="state != 'queued'">
                        The tenant is being created in Microsoft 365. Reload the page in a
                        minute.
                    </div>
                    <field name="pc_request_id" invisible="1"/>
                    <group>
                        <group string="Tenant">
                            <field name="domain" placeholder="contoso.onmicrosoft.com"
                                   readonly="state in ('queued', 'done')"/>
                            <field name="partner_account_id"
                                   readonly="state in ('queued', 'done')"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="state in ('queued', 'done')"/>
                            <field name="organization_registration_number"
                                   readonly="state in ('queued', 'done')"/>
                            <field name="enable_gdap" readonly="state in ('queued', 'done')"/>
                        </group>
                        <group string="Contact">
                            <field name="first_name" readonly="state in ('queued', 'done')"/>
                            <field name="last_name" readonly="state in ('queued', 'done')"/>
                            <field name="email" widget="email"
                                   readonly="state in ('queued', 'done')"/>
                            <field name="phone" widget="phone"
                                   readonly="state in ('queued', 'done')"/>
                            <field name="culture" readonly="state in ('queued', 'done')"/>
                            <field name="language" readonly="state in ('queued', 'done')"/>
                        </group>
                        <group string="Registered Address">
                            <field name="address_line1" readonly="state in ('queued', 'done')"/>
                            <field name="address_line2" readonly="state in ('queued', 'done')"/>
                            <field name="city" readonly="state in ('queued', 'done')"/>
                            <field name="address_state" readonly="state in ('queued', 'done')"/>
                            <field name="postal_code" readonly="state in ('queued', 'done')"/>
                            <field name="country_id" options="{'no_create': True}"
                                   readonly="state in ('queued', 'done')"/>
                            <field name="address_status" invisible="not address_status"/>
                            <field name="address_confirmed"
                                   readonly="state in ('queued', 'done')"/>
                        </group>
                        <group string="Result" invisible="state != 'done'">
                            <field name="customer_id"/>
                            <field name="customer_tenant_id"/>
                            <field name="created_date"/>
                            <field name="admin_username" widget="CopyClipboardChar"/>
                            <field name="admin_password" widget="CopyClipboardChar"
                                   invisible="not admin_password"/>
                            <button name="action_clear_password" type="object"
                                    string="Remove Password from Odoo" class="btn-link"
                                    colspan="2" invisible="not admin_password"
                                    confirm="Remove the initial admin password from Odoo? Hand it over to the customer first."/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_m365_tenant_provision_search" model="ir.ui.view">
        <field name="name">m365.tenant.provision.search</field>
        <field name="model">m365.tenant.provision</field>
        <field name="arch" type="xml">
            <search string="Tenants to Create">
                <field name="name"/>
                <field name="domain"/>
                <field name="email"/>
                <field name="customer_tenant_id"/>
                <filter name="filter_draft" string="To Check" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_ready" string="Ready" domain="[('state', '=', 'ready')]"/>
                <filter name="filter_failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <filter name="filter_done" string="Created" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_country" string="Country"
                            context="{'group_by': 'country_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_m365_tenant_provision_check" model="ir.actions.server">
        <field name="name">Check</field>
        <field name="model_id" ref="model_m365_tenant_provision"/>
        <field name="binding_model_id" ref="model_m365_tenant_provision"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('m365_license_management.group_m365_admin'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_check()</field>
    </record>

    <record id="action_m365_tenant_provision_create" model="ir.actions.server">
        <field name="name">Create in Microsoft 365</field>
        <field name="model_id" ref="model_m365_tenant_provision"/>
        <field name="binding_model_id" ref="model_m365_tenant_provision"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('m365_license_management.group_m365_admin'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_create()</field>
    </record>

    <record id="action_m365_tenant_provision" model="ir.actions.act_window">
        <field name="name">Create Tenants in Server</field>
        <field name="res_model">m365.tenant.provision</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a new Microsoft 365 tenant</p>
            <p>Enter the company, its initial domain (e.g. contoso.onmicrosoft.com), a contact
               and the registered address, press <b>Check</b> and then
               <b>Create in Microsoft 365</b>. Use <i>Multi Tenant</i> to load many customers
               from a CSV or Excel file.</p>
        </field>
    </record>

    <!-- Bulk import (Customers.csv) -->
    <record id="view_m365_tenant_provision_import_wizard" model="ir.ui.view">
        <field name="name">m365.tenant.provision.import.wizard.form</field>
        <field name="model">m365.tenant.provision.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Tenants to Create">
                <div class="alert alert-info" role="alert" invisible="line_count">
                    Upload a <b>CSV</b> or <b>Excel (.xlsx)</b> file with one customer per row
                    (the <i>Customers.csv</i> of the provisioning script) and press
                    <b>Validate</b>. Use <b>Download Template</b> for the columns:
                    <i>CompanyName</i>, <i>Domain</i>, <i>FirstName</i>, <i>LastName</i>,
                    <i>Email</i>, <i>AddressLine1</i>, <i>City</i>, <i>PostalCode</i> and
                    <i>Country</i> are required. A domain without a dot is completed with
                    .onmicrosoft.com and blank cultures and languages use the defaults of the
                    Partner Center account. Nothing is created in Microsoft 365 yet: the
                    tenants are added to the list, where you check and then create them.
                </div>
                <div class="alert alert-success" role="alert"
                     invisible="not line_count or error_count">
                    All <field name="line_count" class="d-inline"/> rows are valid. Press
                    <b>Add Tenants</b> to add them to the list.
                </div>
                <div class="alert alert-danger" role="alert" invisible="not error_count">
                    <field name="error_count" class="d-inline"/> row(s) contain errors. Correct
                    the file, upload it again and press <b>Validate</b>.
                </div>
                <group>
                    <field name="partner_account_id"/>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <field name="line_ids" readonly="1" invisible="not line_count">
                    <list decoration-danger="status == 'error'">
                        <field name="sn"/>
                        <field name="name"/>
                        <field name="domain"/>
                        <field name="email" optional="show"/>
                        <field name="country" optional="show"/>
                        <field name="status" widget="badge"
                               decoration-success="status == 'valid'"
                               decoration-danger="status == 'error'"/>
                        <field name="message"/>
                    </list>
                </field>
                <footer>
                    <button name="action_validate" type="object" string="Validate"
                            class="btn-primary" data-hotkey="v"
                            invisible="line_count and not error_count"/>
                    <button name="action_import" type="object" string="Add Tenants"
                            class="btn-primary" data-hotkey="q"
                            invisible="not line_count or error_count"/>
                    <button name="action_download_template" type="object"
                            string="Download Template" class="btn-secondary"/>
                    <button string="Cancel" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_m365_tenant_provision_import" model="ir.actions.act_window">
        <field name="name">Import Tenants to Create</field>
        <field name="res_model">m365.tenant.provision.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'dialog_size': 'extra-large'}</field>
    </record>
</odoo>
