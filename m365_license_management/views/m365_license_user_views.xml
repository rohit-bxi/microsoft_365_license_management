<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_m365_license_user_list" model="ir.ui.view">
        <field name="name">m365.license.user.list</field>
        <field name="model">m365.license.user</field>
        <field name="arch" type="xml">
            <list string="Microsoft 365 Users" create="0" delete="0">
                <field name="name"/>
                <field name="user_principal_name"/>
                <field name="tenant_id"/>
                <field name="department" optional="show"/>
                <field name="usage_location" optional="show"/>
                <field name="account_enabled" optional="show"/>
                <field name="sku_ids" widget="many2many_tags" string="Licenses"/>
                <field name="license_count"/>
            </list>
        </field>
    </record>

    <record id="view_m365_license_user_form" model="ir.ui.view">
        <field name="name">m365.license.user.form</field>
        <field name="model">m365.license.user</field>
        <field name="arch" type="xml">
            <form string="Microsoft 365 User" create="0" delete="0">
                <header>
                    <button name="action_request_assign" type="object" string="Request License"
                            class="btn-primary"/>
                    <button name="action_request_remove" type="object" string="Request Removal"/>
                    <button name="action_refresh_from_graph" type="object"
                            string="Refresh from Microsoft 365"
                            groups="m365_license_management.group_m365_admin"/>
                    <button name="action_set_usage_location" type="object"
                            string="Set Usage Location"
                            groups="m365_license_management.group_m365_admin"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="tenant_id" readonly="1"/>
                            <field name="user_principal_name" readonly="1"/>
                            <field name="mail" readonly="1"/>
                            <field name="graph_id" readonly="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="department" readonly="1"/>
                            <field name="job_title" readonly="1"/>
                            <field name="usage_location" readonly="1"/>
                            <field name="account_enabled" readonly="1"/>
                            <field name="last_sync"/>
                        </group>
                    </group>
                    <field name="sku_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="sku_part_number"/>
                            <field name="available_units"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_m365_license_user_search" model="ir.ui.view">
        <field name="name">m365.license.user.search</field>
        <field name="model">m365.license.user</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('user_principal_name', 'ilike', self)]"/>
                <field name="tenant_id"/>
                <field name="sku_ids"/>
                <filter name="licensed" string="Licensed" domain="[('license_count', '>', 0)]"/>
                <filter name="unlicensed" string="Unlicensed" domain="[('license_count', '=', 0)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_tenant" string="Tenant" context="{'group_by': 'tenant_id'}"/>
                    <filter name="group_dept" string="Department" context="{'group_by': 'department'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_m365_usage_location_wizard" model="ir.ui.view">
        <field name="name">m365.usage.location.wizard.form</field>
        <field name="model">m365.usage.location.wizard</field>
        <field name="arch" type="xml">
            <form string="Set Usage Location">
                <group>
                    <field name="user_id"/>
                    <field name="country_id" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Apply to Microsoft 365"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_m365_license_user" model="ir.actions.act_window">
        <field name="name">Users</field>
        <field name="res_model">m365.license.user</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
