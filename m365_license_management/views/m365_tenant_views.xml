<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_m365_tenant_list" model="ir.ui.view">
        <field name="name">m365.tenant.list</field>
        <field name="model">m365.tenant</field>
        <field name="arch" type="xml">
            <list string="Tenants" decoration-danger="state == 'error'" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="domain"/>
                <field name="tenant_customer_id" optional="show"/>
                <field name="tenant_type" optional="show"/>
                <field name="tenant_id" optional="hide"/>
                <field name="connection_mode" optional="hide"/>
                <field name="total_licenses"/>
                <field name="assigned_licenses"/>
                <field name="available_licenses"/>
                <field name="last_sync_date" optional="show"/>
                <field name="allow_license_operations" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'connected'"
                       decoration-danger="state == 'error'"
                       decoration-info="state == 'draft'"
                       invisible="tenant_type == 'new' and provision_state != 'done'"/>
                <field name="provision_state" widget="badge" optional="show"
                       decoration-success="provision_state in ('ready', 'done')"
                       decoration-info="provision_state in ('draft', 'queued')"
                       decoration-danger="provision_state == 'failed'"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_m365_tenant_form" model="ir.ui.view">
        <field name="name">m365.tenant.form</field>
        <field name="model">m365.tenant</field>
        <field name="arch" type="xml">
            <form string="Microsoft 365 Tenant">
                <header>
                    <button name="action_check" type="object" string="Check" class="btn-primary"
                            invisible="tenant_type != 'new' or provision_state != 'draft'"
                            groups="m365_license_management.group_m365_admin"/>
                    <button name="action_check" type="object" string="Check Again"
                            invisible="tenant_type != 'new' or provision_state != 'ready'"
                            groups="m365_license_management.group_m365_admin"/>
                    <!-- PARTNER CENTER (disabled)
                    <button name="action_create" type="object" string="Create in Microsoft 365"
                            class="btn-primary"
                            invisible="tenant_type != 'new' or provision_state != 'ready'"
                            confirm="Create this tenant in Microsoft 365? A real tenant is created and it cannot be deleted from Odoo."
                            groups="m365_license_management.group_m365_admin"/>
                    -->
                    <button name="action_create" type="object" string="Create in Microsoft 365"
                            class="btn-primary"
                            invisible="tenant_type != 'new' or provision_state != 'ready'"
                            confirm="Order the Subscriptions to Buy from Ingram Micro, which creates this tenant? The order is billed to your Ingram Micro account and the tenant cannot be deleted from Odoo."
                            groups="m365_license_management.group_m365_admin"/>
                    <button name="action_check_ingram_creation" type="object" string="Check Creation"
                            invisible="tenant_type != 'new' or provision_state != 'queued'"
                            groups="m365_license_management.group_m365_admin"/>
                    <button name="action_create" type="object" string="Retry" class="btn-primary"
                            invisible="tenant_type != 'new' or provision_state != 'failed'"
                            groups="m365_license_management.group_m365_admin"/>
                    <button name="action_reset_creation" type="object" string="Reset to Draft"
                            invisible="tenant_type != 'new' or provision_state != 'failed'"
                            groups="m365_license_management.group_m365_admin"/>
                    <button name="action_grant_consent" type="object" string="Grant Consent"
                            class="btn-primary"
                            invisible="(tenant_type == 'new' and provision_state != 'done') or not tenant_id or connection_mode == 'shared_app' or consent_expiry"
                            groups="m365_license_management.group_m365_admin"/>
                    <button name="action_grant_consent" type="object" string="New Consent Link"
                            invisible="(tenant_type == 'new' and provision_state != 'done') or not tenant_id or (connection_mode == 'own_app' and not consent_expiry)"
                            groups="m365_license_management.group_m365_admin"/>
                    <button name="action_check_consent" type="object" string="Check Consent"
                            invisible="not consent_expiry"
                            groups="m365_license_management.group_m365_admin"/>
                    <button name="action_test_connection" type="object" string="Test Connection"
                            class="btn-primary" invisible="tenant_type == 'new' and provision_state != 'done'" groups="m365_license_management.group_m365_admin"/>
                    <button name="action_sync_inventory" type="object" string="Synchronise Now"
                            invisible="state == 'draft'"
                            groups="m365_license_management.group_m365_admin"/>
                    <button name="action_apply_configuration" type="object"
                            string="Apply Configuration"
                            invisible="state == 'draft' or not config_profile_id or (tenant_type == 'new' and provision_state != 'done')"
                            groups="m365_license_management.group_m365_admin"/>
                    <button name="action_create_user" type="object" string="Create User"
                            invisible="state == 'draft' or not allow_license_operations or (tenant_type == 'new' and provision_state != 'done')"
                            groups="m365_license_management.group_m365_admin"/>
                    <button name="action_buy_licenses" type="object" string="Buy Licenses"
                            invisible="state == 'draft' or (tenant_type == 'new' and provision_state != 'done')"
                            groups="m365_license_management.group_m365_admin"/>
                    <field name="provision_state" widget="statusbar"
                           statusbar_visible="draft,ready,queued,done"
                           invisible="tenant_type != 'new' or provision_state == 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,connected"
                           invisible="tenant_type == 'new' and provision_state != 'done'"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box" invisible="tenant_type == 'new' and provision_state != 'done'">
                        <button name="action_view_skus" type="object" class="oe_stat_button"
                                icon="fa-cubes">
                            <field name="sku_count" widget="statinfo" string="Products"/>
                        </button>
                        <button name="action_view_users" type="object" class="oe_stat_button"
                                icon="fa-users">
                            <field name="user_count" widget="statinfo" string="Users"/>
                        </button>
                        <button name="action_view_requests" type="object" class="oe_stat_button"
                                icon="fa-exchange">
                            <field name="request_count" widget="statinfo" string="Requests"/>
                        </button>
                        <button name="action_view_ingram_orders" type="object"
                                class="oe_stat_button" icon="fa-shopping-cart"
                                invisible="not ingram_order_count"
                                groups="m365_license_management.group_m365_admin">
                            <field name="ingram_order_count" widget="statinfo" string="License Orders"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. BXI Technologies"
                                   readonly="provision_state == 'queued'"/></h1>
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="state != 'error'">
                        <strong>Last error:</strong> <field name="last_error" nolabel="1" class="d-inline"/>
                    </div>
                    <div class="alert alert-danger" role="alert"
                         invisible="not provision_error or provision_state not in ('draft', 'failed')">
                        <field name="provision_error" nolabel="1" class="d-inline"/>
                    </div>
                    <!-- PARTNER CENTER (disabled)
                    <div class="alert alert-warning" role="alert"
                         invisible="provision_state != 'failed' or not pc_request_id">
                        Partner Center gave no answer, so the tenant may have been created.
                        <b>Retry</b> sends the same request ID: Microsoft then returns the
                        tenant it created instead of creating a second one.
                    </div>
                    -->
                    <div class="alert alert-warning" role="alert" invisible="config_state != 'failed'">
                        <strong>Configuration failed:</strong>
                        <field name="config_error" nolabel="1" class="d-inline"/>
                    </div>
                    <!-- PARTNER CENTER (disabled)
                    <div class="alert alert-info" role="alert" invisible="provision_state != 'queued'">
                        The tenant is being created in Microsoft 365. Reload the page in a
                        minute.
                    </div>
                    -->
                    <div class="alert alert-info" role="alert" invisible="provision_state != 'queued'">
                        Ingram Micro creates the tenant with the order
                        <field name="ingram_creation_order_id" nolabel="1" class="d-inline"
                               groups="m365_license_management.group_m365_admin"/>,
                        once it is approved. Odoo sees the tenant when its domain exists in
                        Microsoft 365: checked every hour, or press <b>Check Creation</b>.
                        Ingram Micro gives the initial admin user.
                    </div>
                    <div class="alert alert-info" role="alert"
                         invisible="provision_state != 'done' or state != 'draft' or consent_expiry">
                        The tenant is created in Microsoft 365. To manage its licenses, press
                        <b>Grant Consent</b> and sign in with its initial admin user (given by
                        Ingram Micro): the tenant is then connected through the shared app.
                        Or enter the client ID and secret of an app registration of
                        the tenant (<i>Entra App Registration</i> tab) and press
                        <b>Test Connection</b>.
                    </div>
                    <div class="alert alert-info" role="alert" invisible="not consent_expiry">
                        Waiting for the admin consent of the shared app: a Global Administrator
                        of the tenant opens the consent link (<i>Entra App Registration</i>
                        tab) and accepts. If consent was granted but the tenant is not
                        connected, press <b>Check Consent</b> after a few minutes.
                    </div>
                    <field name="pc_request_id" invisible="1"/>
                    <group>
                        <group string="Tenant">
                            <field name="tenant_type" widget="radio" options="{'horizontal': true}"
                                   readonly="state != 'draft' or provision_state in ('queued', 'done')"/>
                            <field name="domain" readonly="provision_state == 'queued'"/>
                            <field name="tenant_customer_id" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Inventory" invisible="tenant_type == 'new' and provision_state != 'done'">
                            <field name="total_licenses"/>
                            <field name="assigned_licenses"/>
                            <field name="available_licenses"/>
                            <field name="last_sync_date"/>
                            <field name="last_user_sync_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tenant Creation" name="creation" invisible="tenant_type != 'new'"
                              groups="m365_license_management.group_m365_admin">
                            <group>
                                <group string="Ingram Micro">
                                    <field name="requested_subscriptions"
                                           required="tenant_type == 'new' and provision_state == 'draft'"
                                           readonly="provision_state in ('queued', 'done')"
                                           placeholder="Microsoft 365 Business Basic = 10"/>
                                    <field name="mca_accepted" readonly="provision_state in ('queued', 'done')"/>
                                    <field name="mca_first_name" invisible="not mca_accepted"
                                           required="mca_accepted" readonly="provision_state in ('queued', 'done')"/>
                                    <field name="mca_last_name" invisible="not mca_accepted"
                                           required="mca_accepted" readonly="provision_state in ('queued', 'done')"/>
                                    <field name="mca_email" widget="email" invisible="not mca_accepted"
                                           required="mca_accepted" readonly="provision_state in ('queued', 'done')"/>
                                    <field name="mca_date" invisible="not mca_accepted"
                                           required="mca_accepted" readonly="provision_state in ('queued', 'done')"/>
                                    <field name="ingram_creation_order_id" invisible="not ingram_creation_order_id"/>
                                    <field name="partner_account_id" string="Shared App Account"
                                           invisible="not partner_account_id"
                                           readonly="provision_state in ('queued', 'done')"/>
                                    <!-- Anchor of the views stored before 19.0.1.10.1 (upgrade) -->
                                    <field name="enable_gdap" invisible="1"/>
                                    <div colspan="2" class="text-muted">
                                        Ingram Micro creates the tenant with the order of the
                                        Subscriptions to Buy, with the acceptance of the
                                        Microsoft Customer Agreement and the address below.
                                    </div>
                                </group>
                                <!-- PARTNER CENTER (disabled)
                                <group string="Partner Center">
                                    <field name="partner_account_id" required="tenant_type == 'new'"
                                           readonly="provision_state in ('queued', 'done')"/>
                                    <field name="organization_registration_number" readonly="provision_state in ('queued', 'done')"/>
                                    <field name="enable_gdap" readonly="provision_state in ('queued', 'done')"/>
                                </group>
                                -->
                                <group string="Contact">
                                    <field name="contact_first_name" readonly="provision_state in ('queued', 'done')"/>
                                    <field name="contact_last_name" readonly="provision_state in ('queued', 'done')"/>
                                    <field name="contact_email" widget="email" readonly="provision_state in ('queued', 'done')"/>
                                    <field name="contact_phone" widget="phone" required="tenant_type == 'new'"
                                           readonly="provision_state in ('queued', 'done')"/>
                                    <!-- PARTNER CENTER (disabled)
                                    <field name="culture" readonly="provision_state in ('queued', 'done')"/>
                                    <field name="language" readonly="provision_state in ('queued', 'done')"/>
                                    -->
                                </group>
                                <group string="Registered Address">
                                    <field name="address_line1" readonly="provision_state in ('queued', 'done')"/>
                                    <field name="address_line2" readonly="provision_state in ('queued', 'done')"/>
                                    <field name="city" readonly="provision_state in ('queued', 'done')"/>
                                    <field name="address_state" readonly="provision_state in ('queued', 'done')"/>
                                    <field name="postal_code" readonly="provision_state in ('queued', 'done')"/>
                                    <field name="country_id" options="{'no_create': True}"
                                           readonly="provision_state in ('queued', 'done')"/>
                                    <!-- PARTNER CENTER (disabled)
                                    <field name="address_status" invisible="not address_status"/>
                                    <field name="address_confirmed" readonly="provision_state in ('queued', 'done')"/>
                                    -->
                                </group>
                                <group string="Result" invisible="provision_state != 'done'">
                                    <field name="tenant_id" readonly="1"/>
                                    <field name="created_date"/>
                                    <field name="queued_by"/>
                                    <!-- PARTNER CENTER (disabled): customer and admin user returned by Partner Center
                                    <field name="customer_id"/>
                                    <field name="admin_username" widget="CopyClipboardChar"/>
                                    <field name="admin_password" widget="CopyClipboardChar"
                                           invisible="not admin_password"/>
                                    <button name="action_clear_password" type="object"
                                            string="Remove Password from Odoo" class="btn-link"
                                            colspan="2" invisible="not admin_password"
                                            confirm="Remove the initial admin password from Odoo? Hand it over to the customer first."/>
                                    -->
                                </group>
                            </group>
                        </page>
                        <page string="Entra App Registration" name="connection" invisible="tenant_type == 'new' and provision_state != 'done'">
                            <group>
                                <group string="OAuth 2.0 (Client Credentials)">
                                    <field name="connection_mode" widget="radio"
                                           options="{'horizontal': true}"/>
                                    <field name="tenant_id" readonly="tenant_type == 'new'"
                                           required="tenant_type == 'existing'"/>
                                    <field name="partner_account_id" string="Shared App Account"
                                           invisible="tenant_type == 'new'"
                                           required="connection_mode == 'shared_app'"
                                           options="{'no_create': True}"
                                           groups="m365_license_management.group_m365_admin"/>
                                    <field name="client_id" invisible="connection_mode == 'shared_app'"
                                           required="tenant_type == 'existing' and connection_mode == 'own_app'"/>
                                    <field name="client_secret" password="True"
                                           invisible="connection_mode == 'shared_app'"
                                           groups="m365_license_management.group_m365_admin"/>
                                </group>
                                <group string="Endpoints">
                                    <field name="authority_url"/>
                                    <field name="graph_url"/>
                                    <field name="graph_scope"/>
                                </group>
                                <group string="Admin Consent (Shared App)"
                                       invisible="not consent_expiry and not consent_date"
                                       groups="m365_license_management.group_m365_admin">
                                    <field name="consent_url" widget="CopyClipboardChar"
                                           invisible="not consent_url"/>
                                    <field name="consent_expiry" invisible="not consent_expiry"/>
                                    <field name="consent_requested_by"/>
                                    <field name="consent_date" invisible="not consent_date"/>
                                </group>
                            </group>
                        </page>
                        <page string="Operations &amp; Automation" name="operations"
                              invisible="tenant_type == 'new' and provision_state != 'done'">
                            <group>
                                <group string="License Operations">
                                    <field name="allow_license_operations"/>
                                    <field name="auto_approve_admins"
                                           invisible="not allow_license_operations"/>
                                </group>
                                <group string="Security Operations">
                                    <field name="allow_security_operations"/>
                                    <div colspan="2" class="text-muted">
                                        Reset MFA, per-user MFA off, Security Defaults off and
                                        Temporary Access Passes. MFA requests always wait for
                                        the approval of an administrator.
                                    </div>
                                </group>
                                <group string="Scheduled Synchronisation">
                                    <field name="sync_enabled"/>
                                    <field name="sync_users" invisible="not sync_enabled"/>
                                </group>
                                <group string="Low Availability Alerts">
                                    <field name="low_availability_percent"/>
                                    <field name="low_availability_units"/>
                                </group>
                            </group>
                        </page>
                        <page string="Configuration" name="configuration"
                              invisible="(tenant_type == 'new' and provision_state != 'done')"
                              groups="m365_license_management.group_m365_admin">
                            <group>
                                <group string="Configuration Profile">
                                    <field name="config_profile_id" options="{'no_create': True}"/>
                                    <field name="config_state" widget="badge"
                                           decoration-success="config_state == 'applied'"
                                           decoration-danger="config_state == 'failed'"/>
                                    <field name="config_date" invisible="not config_date"/>
                                </group>
                                <group string="Security Defaults">
                                    <field name="security_defaults_state" widget="badge"
                                           decoration-success="security_defaults_state == 'on'"
                                           decoration-warning="security_defaults_state == 'off'"/>
                                    <div colspan="2">
                                        <button name="action_security_defaults_wizard" type="object"
                                                string="Turn Off Security Defaults" class="btn-secondary me-2"
                                                invisible="not allow_security_operations or security_defaults_state == 'off' or state == 'draft'"/>
                                        <button name="action_security_defaults_wizard" type="object"
                                                string="Turn On Security Defaults" class="btn-secondary"
                                                context="{'m365_enable': True}"
                                                invisible="security_defaults_state == 'on' or state == 'draft'"/>
                                    </div>
                                </group>
                            </group>
                        </page>
                        <page string="Purchasing" name="purchasing"
                              invisible="(tenant_type == 'new' and provision_state != 'done')"
                              groups="m365_license_management.group_m365_admin">
                            <group>
                                <group string="Ingram Micro">
                                    <field name="ingram_relationship"/>
                                    <field name="ingram_relationship_date"
                                           invisible="not ingram_relationship"/>
                                </group>
                                <group string="Microsoft Customer Agreement">
                                    <field name="mca_accepted"/>
                                    <field name="mca_first_name" invisible="not mca_accepted"
                                           required="mca_accepted"/>
                                    <field name="mca_last_name" invisible="not mca_accepted"
                                           required="mca_accepted"/>
                                    <field name="mca_email" widget="email"
                                           invisible="not mca_accepted" required="mca_accepted"/>
                                    <field name="mca_phone" widget="phone"
                                           invisible="not mca_accepted"/>
                                    <field name="mca_date" invisible="not mca_accepted"
                                           required="mca_accepted"/>
                                </group>
                            </group>
                            <div class="alert alert-info" role="alert">
                                Ingram Micro can only buy subscriptions for customers that have
                                a reseller relationship with it (the customer accepts the
                                invitation of Ingram Micro in the Microsoft 365 admin center)
                                and that accepted the Microsoft Customer Agreement. Partner
                                Center shows the relationships only to a signed-in partner user,
                                so Odoo cannot check them: confirm them here. The acceptance is
                                sent with the orders through the <i>Vendor Fields</i> of the
                                Ingram Micro account.
                            </div>
                        </page>
                        <page string="Domains" name="domains" invisible="(tenant_type == 'new' and provision_state != 'done')">
                            <div class="mb-2" groups="m365_license_management.group_m365_admin">
                                <button name="action_add_domain" type="object" string="Add Domain"
                                        class="btn-secondary me-2" invisible="state == 'draft'"/>
                                <button name="action_sync_domains" type="object"
                                        string="Refresh Domains" class="btn-secondary"
                                        invisible="state == 'draft'"/>
                            </div>
                            <field name="domain_ids" readonly="1">
                                <list decoration-muted="not is_verified">
                                    <field name="name"/>
                                    <field name="is_verified"/>
                                    <field name="is_default"/>
                                    <field name="is_initial"/>
                                    <field name="authentication_type"/>
                                    <field name="password_never_expires"/>
                                </list>
                            </field>
                        </page>
                        <page string="Users with Access" name="access"
                              groups="m365_license_management.group_m365_admin">
                            <field name="customer_user_mapping_ids" readonly="1">
                                <list>
                                    <field name="user_id"/>
                                    <field name="customer_count"/>
                                </list>
                            </field>
                            <div class="alert alert-info" role="alert">
                                Microsoft 365 users only see the tenants of the customers
                                mapped to them in
                                <i>Configuration › User Customer Mapping</i>. Administrators
                                see every tenant.
                            </div>
                        </page>
                        <page string="Live Sync" name="live_sync" invisible="tenant_type == 'new' and provision_state != 'done'"
                              groups="m365_license_management.group_m365_admin">
                            <group>
                                <group string="Delta Synchronisation">
                                    <field name="use_delta_sync"/>
                                    <button name="action_reset_delta" type="object"
                                            string="Force full user re-read" class="btn-link"
                                            invisible="not use_delta_sync"/>
                                </group>
                                <group string="Webhook (change notifications)">
                                    <field name="webhook_url" readonly="1"/>
                                    <field name="webhook_enabled"/>
                                    <field name="webhook_subscription_id"
                                           invisible="not webhook_enabled"/>
                                    <field name="webhook_expiry" invisible="not webhook_enabled"/>
                                    <field name="webhook_last_received"/>
                                    <div colspan="2">
                                        <button name="action_webhook_subscribe" type="object"
                                                string="Subscribe" class="btn-primary me-2"
                                                invisible="webhook_enabled or state == 'draft'"/>
                                        <button name="action_webhook_subscribe" type="object"
                                                string="Re-create" class="me-2"
                                                invisible="not webhook_enabled"/>
                                        <button name="action_webhook_unsubscribe" type="object"
                                                string="Unsubscribe"
                                                invisible="not webhook_enabled"/>
                                    </div>
                                </group>
                            </group>
                            <div class="alert alert-info" role="alert">
                                Microsoft calls the notification URL when a user changes, so
                                license changes made in the Microsoft 365 admin center appear
                                within about a minute. Requires a public <b>HTTPS</b> address
                                (system parameter <code>web.base.url</code>) and Odoo running
                                with workers. Subscribed SKUs have no notification and are
                                refreshed on each notification and every 30 minutes.
                            </div>
                        </page>
                        <page string="Products" name="products" invisible="tenant_type == 'new' and provision_state != 'done'">
                            <field name="sku_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="sku_part_number"/>
                                    <field name="enabled_units" string="Total"/>
                                    <field name="consumed_units" string="Assigned"/>
                                    <field name="available_units"/>
                                    <field name="utilization" widget="progressbar"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                        <page string="Setup Guide" name="guide">
                            <div class="o_m365_guide">
                                <h4>New tenants</h4>
                                <p>Choose the type <b>New</b> to have the tenant created by
                                   Ingram Micro: enter the initial domain (e.g.
                                   contoso.onmicrosoft.com), a contact, the registered address,
                                   the Subscriptions to Buy and who accepted the Microsoft
                                   Customer Agreement, press <b>Check</b>, then <b>Create in
                                   Microsoft 365</b>: the subscriptions are ordered from Ingram
                                   Micro, which creates the tenant. Once Odoo sees it in
                                   Microsoft 365, its directory ID is filled in: connect it with
                                   the shared app or with its own app registration, as below.</p>
                                <!-- PARTNER CENTER (disabled)
                                <p>Choose the type <b>New</b> to create the tenant through
                                   Microsoft Partner Center (<i>Partner Center Account</i> menu):
                                   enter the initial domain (e.g. contoso.onmicrosoft.com), a
                                   contact and the registered address, press <b>Check</b>, then
                                   <b>Create in Microsoft 365</b>. Once it is created, its
                                   directory ID is filled in: connect it with the shared app or
                                   with its own app registration, as below.</p>
                                -->
                                <h4>Shared app (recommended)</h4>
                                <p>One multi-tenant app of your own tenant connects every
                                   tenant, without app registration in each one. Configure it
                                   once in <i>Configuration › Tenants › Shared App</i>
                                   (application ID, secret, redirect URI and Graph
                                   permissions). Then, on each
                                   tenant, press <b>Grant Consent</b>: a Global Administrator of
                                   the tenant signs in on the Microsoft page that opens (or the
                                   consent link sent to them) and accepts. Odoo connects the
                                   tenant as soon as the shared app can read it.</p>
                                <h4>Own app registration</h4>
                                <h4>1. Register an application in Microsoft Entra ID</h4>
                                <p>Entra admin center &#8594; App registrations &#8594; New registration.
                                   Copy the <b>Directory (tenant) ID</b> and <b>Application (client) ID</b>
                                   and create a <b>client secret</b> (Certificates &amp; secrets).</p>
                                <h4>2. Grant Microsoft Graph <i>application</i> permissions (admin consent)</h4>
                                <ul>
                                    <li><b>Inventory and users:</b> <code>Organization.Read.All</code>
                                        and <code>User.Read.All</code>.</li>
                                    <li><b>License operations and user creation:</b>
                                        <code>LicenseAssignment.ReadWrite.All</code> and
                                        <code>User.ReadWrite.All</code>.</li>
                                    <li><b>Configuration and domains:</b>
                                        <code>Policy.Read.All</code>,
                                        <code>Policy.ReadWrite.ConditionalAccess</code> (Security
                                        Defaults), <code>Domain.ReadWrite.All</code> and
                                        <code>Organization.ReadWrite.All</code> (technical
                                        contact).</li>
                                    <li><b>Security operations:</b>
                                        <code>UserAuthenticationMethod.ReadWrite.All</code> (MFA
                                        methods, Temporary Access Pass) and
                                        <code>Policy.ReadWrite.AuthenticationMethod</code>
                                        (per-user MFA, Temporary Access Pass policy).</li>
                                </ul>
                                <p class="text-muted">Grant only what the switches of the tenant use
                                   (least privilege). With the shared app, a permission added later
                                   needs a new consent in each tenant.</p>
                                <h4>3. Test the connection</h4>
                                <p>Fill in the IDs and secret, save and press <b>Test Connection</b>,
                                   then <b>Synchronise Now</b> to load the license inventory.</p>
                                <p class="text-muted">Users must have a <i>usage location</i> in Microsoft 365
                                   before a license can be assigned.</p>
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_m365_tenant_search" model="ir.ui.view">
        <field name="name">m365.tenant.search</field>
        <field name="model">m365.tenant</field>
        <field name="arch" type="xml">
            <search string="Tenants">
                <field name="name"/>
                <field name="domain"/>
                <field name="tenant_id"/>
                <field name="tenant_customer_id"/>
                <filter name="filter_connected" string="Connected" domain="[('state', '=', 'connected')]"/>
                <filter name="filter_error" string="Connection Error" domain="[('state', '=', 'error')]"/>
                <separator/>
                <filter name="filter_existing" string="Existing" domain="[('tenant_type', '=', 'existing')]"/>
                <filter name="filter_new" string="New" domain="[('tenant_type', '=', 'new')]"/>
                <filter name="filter_to_create" string="To Create"
                        domain="[('tenant_type', '=', 'new'), ('provision_state', '!=', 'done')]"/>
                <separator/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_type" string="Type" context="{'group_by': 'tenant_type'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_customer" string="Customer"
                            context="{'group_by': 'tenant_customer_id'}"/>
                </group>
            </search>
        </field>
    </record>

