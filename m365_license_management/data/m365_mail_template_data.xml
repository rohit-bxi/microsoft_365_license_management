<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- DNS records the customer adds to prove the ownership of its domains -->
    <record id="mail_template_m365_dns_records" model="mail.template">
        <field name="name">Microsoft 365: DNS Records to Add</field>
        <field name="model_id" ref="model_m365_tenant"/>
        <field name="subject">Microsoft 365: DNS records to add for {{ object.name }}</field>
        <field name="email_to">{{ object.contact_email or object.mca_email or object.tenant_customer_id.email or '' }}</field>
        <field name="description">Sent to the customer: TXT records verifying its domains</field>
        <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p>Hello,</p>
    <p>To use your domains with Microsoft 365, please add the following DNS records at
       the DNS host of each domain (TXT record, host <b>@</b>, TTL 3600):</p>
    <table style="border-collapse: collapse;" cellpadding="6">
        <tr>
            <th style="text-align: left; border-bottom: 1px solid #ccc;">Domain</th>
            <th style="text-align: left; border-bottom: 1px solid #ccc;">TXT value</th>
        </tr>
        <t t-foreach="object.dns_pending_domain_ids" t-as="domain">
            <tr>
                <td style="border-bottom: 1px solid #eee;" t-out="domain.name"/>
                <td style="border-bottom: 1px solid #eee;"><code t-out="domain.txt_record or ''"/></td>
            </tr>
        </t>
    </table>
    <p>We check the records automatically: changes at the DNS host can take a few hours to
       be visible. Reply to this email if you need help.</p>
    <p>Thank you.</p>
</div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>
</odoo>
