<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_m365_sync_tenants" model="ir.cron">
        <field name="name">Microsoft 365: Synchronise Tenants</field>
        <field name="model_id" ref="model_m365_tenant"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_all()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_m365_cleanup_snapshots" model="ir.cron">
        <field name="name">Microsoft 365: Purge Old Inventory Snapshots</field>
        <field name="model_id" ref="model_m365_inventory_snapshot"/>
        <field name="state">code</field>
        <field name="code">model._cron_cleanup()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_m365_cleanup_audit" model="ir.cron">
        <field name="name">Microsoft 365: Purge Old Audit Logs</field>
        <field name="model_id" ref="model_m365_audit_log"/>
        <field name="state">code</field>
        <field name="code">model._cron_cleanup()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_m365_process_webhooks" model="ir.cron">
        <field name="name">Microsoft 365: Process Change Notifications</field>
        <field name="model_id" ref="model_m365_tenant"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_webhooks()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_m365_webhook_maintenance" model="ir.cron">
        <field name="name">Microsoft 365: Renew Webhook Subscriptions</field>
        <field name="model_id" ref="model_m365_tenant"/>
        <field name="state">code</field>
        <field name="code">model._cron_webhook_maintenance()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Triggered when tenants are queued; the hourly run picks up interrupted ones -->
    <record id="ir_cron_m365_create_tenants" model="ir.cron">
        <field name="name">Microsoft 365: Create Queued Tenants</field>
        <field name="model_id" ref="model_m365_tenant"/>
        <field name="state">code</field>
        <field name="code">model._cron_provision_tenants()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_m365_ingram_events" model="ir.cron">
        <field name="name">Microsoft 365: Process Ingram Micro Events</field>
        <field name="model_id" ref="model_m365_ingram_event"/>
        <field name="state">code</field>
        <field name="code">model._cron_process()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_m365_ingram_deliveries" model="ir.cron">
        <field name="name">Microsoft 365: Check License Order Deliveries</field>
        <field name="model_id" ref="model_m365_ingram_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_deliveries()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_m365_ingram_billing" model="ir.cron">
        <field name="name">Microsoft 365: Synchronise Ingram Micro Invoices and Renewals</field>
        <field name="model_id" ref="model_m365_ingram_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_billing()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_m365_ingram_events_cleanup" model="ir.cron">
        <field name="name">Microsoft 365: Purge Old Ingram Micro Events</field>
        <field name="model_id" ref="model_m365_ingram_event"/>
        <field name="state">code</field>
        <field name="code">model._cron_cleanup()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_m365_gdap" model="ir.cron">
        <field name="name">Microsoft 365: Refresh GDAP Status</field>
        <field name="model_id" ref="model_m365_tenant"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh_gdap()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <!-- PARTNER CENTER (disabled): subscriptions are bought through Ingram Micro only.
         Kept inactive (migration 19.0.1.10.2 deactivates it on existing databases). -->
    <record id="ir_cron_m365_pc_orders" model="ir.cron">
        <field name="name">Microsoft 365: Follow Partner Center Orders</field>
        <field name="model_id" ref="model_m365_pc_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_progress()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="False"/>
    </record>

    <record id="ir_cron_m365_verify_licenses" model="ir.cron">
        <field name="name">Microsoft 365: Verify Assigned Licenses</field>
        <field name="model_id" ref="model_m365_license_request"/>
        <field name="state">code</field>
        <field name="code">model._cron_verify()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Bulk provisioning (19.0.1.8.0) -->
    <record id="ir_cron_m365_auto_provision" model="ir.cron">
        <field name="name">Microsoft 365: Run Automatic Provisioning</field>
        <field name="model_id" ref="model_m365_tenant"/>
        <field name="state">code</field>
        <field name="code">model._cron_auto_provision()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_m365_auto_domains" model="ir.cron">
        <field name="name">Microsoft 365: Add and Verify Custom Domains</field>
        <field name="model_id" ref="model_m365_tenant_domain"/>
        <field name="state">code</field>
        <field name="code">model._cron_auto_domains()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_m365_create_pending_users" model="ir.cron">
        <field name="name">Microsoft 365: Create Waiting Users</field>
        <field name="model_id" ref="model_m365_tenant_pending_user"/>
        <field name="state">code</field>
        <field name="code">model._cron_create_users()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_m365_partner_signin" model="ir.cron">
        <field name="name">Microsoft 365: Keep the Partner User Signed In</field>
        <field name="model_id" ref="model_m365_partner_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_partner_signin()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
